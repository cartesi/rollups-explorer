{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["./**/*.ts", "./**/*.mts"]
}
